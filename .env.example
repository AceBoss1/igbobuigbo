# .env.local
# ─────────────────────────────────────────────────────────────────────────────
# IGBOBUIGBO.ORG.NG — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER put real values in this file, and NEVER commit .env.local to git.
# Variable names below match what the code reads (process.env.*). Only
# NEXT_PUBLIC_* values are exposed to the browser — secrets must NOT use it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Client SDK — public by design) ─────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (SECRET) ──────────────────────────────────────────────
# From your Firebase Service Account JSON (Project Settings → Service Accounts)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value here. The \n characters will be handled automatically.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Paystack ─────────────────────────────────────────────────────────────────
# From https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Email (router tries Gmail → Resend → Brevo) ──────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# From https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
ADMIN_EMAIL=
STATUS_ALERT_EMAIL=

# ── Termii (SMS) ─────────────────────────────────────────────────────────────
# From https://termii.com → Settings → API Keys
TERMII_API_KEY=

# ── Cloudinary (unsigned upload preset; the API secret is NOT used client-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── EmailJS (Coming Soon waitlist, client-side) ──────────────────────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_WAITLIST_TEMPLATE=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Secrets for admin bootstrap and cron routes ──────────────────────────────
# Generate each with:  openssl rand -base64 32
ADMIN_BOOTSTRAP_SECRET=
CRON_SECRET=
BACKUP_GCS_BUCKET=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://igbobuigbo.org.ng
